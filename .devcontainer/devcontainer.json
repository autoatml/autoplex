{
  "name": "DeveloperEnv",
  "image": "ghcr.io/autoatml/autoplex/autoplex-python-3.12:main",
  "initializeCommand": "docker system prune --all --force",
  "hostRequirements": {
   "cpus": 4,
   "memory": "16gb",
   "storage": "32gb"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-azuretools.vscode-docker"]
    },
  },
  "postCreateCommand": "pip cache purge && uv pip install --system -e '.[strict,docs,tests]' && pre-commit install",
}
